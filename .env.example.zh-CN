# ============================================================
# 小鱼交易台 — 环境配置（复制为 .env 后填写，chmod 600）
# 绝不提交 .env 到版本库
# ============================================================

# ====================== IBKR ======================
# ib-gateway 容器登录凭证（强烈建议用只读子用户，勿用主用户）
TWS_USERID=
TWS_PASSWORD=
# 移动验证器 TOTP secret（32 位，IBGA 自动生成 6 位验证码）
TOTP_KEY=
# IBGA 镜像的 API 端口固定 4000
IB_HOST=ib-gateway
IB_PORT=4000
IB_CLIENT_ID=17
# 多账户时指定（如 U1234567）；单账户留空自动选取
IB_ACCOUNT=
# executions 专用连接：IBKR 规定只有 clientId=0 能看到手动下的单
IB_EXEC_CLIENT_ID=0
# 行情类型：1=实时（需付费订阅）3=延迟（免费）
IB_MARKET_DATA_TYPE=3

# ====================== 富途实时行情（仅报价） ======================
# 持仓、资金、订单、成交、PnL 永远来自 IBKR；富途故障/过期自动逐标的回退 IBKR。
FUTU_QUOTE_ENABLED=false
FUTU_HOST=host.docker.internal
FUTU_PORT=11111
FUTU_CONNECT_TIMEOUT=1.5
FUTU_QUOTE_STALE_SECONDS=300

# 注：Flex Query 配置见文件末尾「现金流与真实收益层」一节。

# --- 加密密钥（敏感字段落库前加密）---
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 丢失此密钥将无法解密已存储的内容 —— 请离线备份
ACCOUNT_ENC_KEY=

# --- 文件路径 ---
DB_PATH=./data/dashboard.db
SECTOR_MAP_PATH=./config/sectors.json
LOG_PATH=./data/dashboard.log
LOG_LEVEL=INFO

# --- SQLite gzip 热备份 ---
# 数据库可能快速增长，默认只保留最近 2 份；请按磁盘容量调整。
BACKUP_KEEP=2

# --- 看板账号密码登录 ---
# 暂时关闭；需要恢复登录窗口时改为 true 并重启 web 服务。
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_AUTH_USER=admin

# --- 时区（数据层用美东交易日，展示层用北京时间）---
MARKET_TZ=America/New_York

# ---------- 市场环境引擎 v1 ----------
# 数据源复用 IBKR 历史日线，不需要额外 API 密钥。
MARKET_ENABLED=true
MARKET_SYNC_INTERVAL_MIN=30
MARKET_LOOKBACK_DAYS=260          # 约一年交易日：200 日均线与 VIX 分位数都需要足够历史
MARKET_MAX_LAG_DAYS=4             # 超过即判 stale（覆盖长周末与节假日）
MARKET_PERCENTILE_WINDOW=252      # 波动率分位数窗口，必须随指标一起展示

# 规则阈值（改动会改变 rule_set_version，历史评估不受影响）
MARKET_VIX_WARN=20
MARKET_VIX_CRIT=30
MARKET_VIX_SPIKE=0.15             # 单日涨幅
MARKET_VXN_WARN=25
MARKET_VXN_VIX_GAP=5              # VXN 高出 VIX 多少视为科技股压力
MARKET_QQQ_DRAWDOWN_MAX=0.10
MARKET_SOX_UNDERPERFORM_MAX=-0.05
MARKET_RATES_LEVEL_MAX=45         # IBKR TNX 报的是收益率×10，45 = 4.5%
LOCAL_TZ=Asia/Shanghai

# --- 同步间隔（秒）---
POSITIONS_SYNC_INTERVAL=60
ORDERS_SYNC_INTERVAL=300
EXEC_SYNC_INTERVAL=45
# 实时层：IBKR/Futu 长连接事件 → 1 秒页面态、5 秒快照/风控、60 秒完整校准。
# 生产启用后，分钟级 POSITIONS_SYNC_INTERVAL 仍作为独立兜底。
LIVE_SYNC_ENABLED=true
LIVE_PUBLISH_INTERVAL=1
LIVE_FLUSH_INTERVAL=5
LIVE_RECONCILE_INTERVAL=60

# --- 告警节流 ---
# 显著恶化判定：绝对变化 ≥ N 个百分点，或相对变化 ≥ N%
ALERT_WORSEN_ABS=0.05
ALERT_WORSEN_REL=0.20
# 同一条告警解除后再触发的冷却分钟数（防止价格贴止损线来回抖动刷屏）
ALERT_RETRIGGER_COOLDOWN_MIN=30

# --- Apprise 推送（飞书等），多个用逗号分隔 ---
# 飞书: feishu://<webhook_token>
APPRISE_URLS=

# --- 心跳监控（dead man's switch，可选但强烈建议）---
# 在 healthchecks.io 建一个 check，把 ping URL 填这里；
# 同步进程失联超时后，healthchecks 会主动通知你
HEARTBEAT_URL=

# --- 数据质量层阈值（账户快照层）---
# 交易时段 / 休市时段的数据过期阈值（秒）。休市本就低频更新，同一标准必然误报
DQ_STALE_SECONDS_MARKET=300
DQ_STALE_SECONDS_CLOSED=7200
# 超过此秒数视为严重过期：整体判 error 并禁止 AI 分析
DQ_ERROR_SECONDS=86400
# 持仓明细合计 vs 账户持仓总市值的相对容差
DQ_POSITIONS_VALUE_REL_TOL=0.02
# 净资产 ≈ 现金 + 持仓市值 的相对容差（未结算资金 / 多币种折算留缓冲）
DQ_EQUITY_IDENTITY_REL_TOL=0.05
# 相邻快照净资产跳变告警阈值
DQ_EQUITY_JUMP_REL=0.20
# 当日盈亏占净资产超过该比例告警
DQ_DAILY_PNL_REL_WARN=0.20
# 单只持仓市值/净资产超过该比例且无融资迹象时告警
DQ_SINGLE_POSITION_OVER_EQUITY=1.00
# 手动触发同步的最小间隔（秒）与「同步任务僵死」判定秒数
MANUAL_SYNC_MIN_INTERVAL=30
SYNC_STALE_RUNNING_SECONDS=600

# --- 同步重试（只对瞬时网络故障生效；认证/权限错误不重试）---
SYNC_MAX_RETRIES=2
SYNC_RETRY_BASE_DELAY=1.0

# --- 风险引擎阈值（与 R1/R2 同口径，改一处两边都变）---
RISK_SINGLE_WEIGHT_EQUITY_MAX=0.30
RISK_SINGLE_WEIGHT_INVESTED_MAX=0.50
RISK_TOP3_INVESTED_MAX=0.80
RISK_TOP5_INVESTED_MAX=0.95
RISK_UNKNOWN_SECTOR_MAX=0.30
RISK_CASH_RATIO_MIN=0.05
RISK_GROSS_LEVERAGE_MAX=2.0
RISK_NET_LEVERAGE_MAX=1.5
RISK_MAINT_SAFETY_MIN=2.0
RISK_EXCESS_LIQUIDITY_MIN=0.10
RISK_DAILY_LOSS_MAX=0.03
RISK_DRAWDOWN_MAX=0.15
RISK_MAX_DRAWDOWN_MAX=0.25
RISK_POSITION_LOSS_MAX=0.20
RISK_LOSS_CONTRIBUTION_MAX=0.60
# 评分权重（六维，合计建议为 1）
RISK_WEIGHT_CONCENTRATION=0.25
RISK_WEIGHT_LEVERAGE=0.20
RISK_WEIGHT_DRAWDOWN=0.20
RISK_WEIGHT_LIQUIDITY=0.20
RISK_WEIGHT_LOSS=0.10
RISK_WEIGHT_DATA_QUALITY=0.05

# --- Docker 部署：看板对外暴露（Caddy）---
# 域名需在 Cloudflare 托管
DASHBOARD_SITE=dash.example.com
# Cloudflare API Token（Zone→DNS→Edit），供 Caddy DNS-01 签发证书
CF_API_TOKEN=

# ---------- 风险事件运营层 v1 ----------
# 默认只推 high/critical。warning 只进时间线不推送 —— 告警疲劳比漏报更致命：
# 一个每天响 30 次的看板，三天后会被静音，那时真正的 critical 也一起没了。
ALERT_NOTIFY_CRITICAL=true
ALERT_NOTIFY_HIGH=true
ALERT_NOTIFY_WARNING=false
ALERT_NOTIFY_RECOVERY=true
ALERT_NOTIFY_DATA_QUALITY=true
ALERT_COOLDOWN_MINUTES=240        # 同一事件冷静期；严重度升级会绕过它
ALERT_MAX_PER_HOUR=6
ALERT_MAX_PER_DAY=20
ALERT_MERGE_BATCH=true            # 同一轮的多条相关事件合并成一条通知
ALERT_OUTSIDE_MARKET_HOURS=true
ALERT_MAX_RETRIES=2               # 发送失败重试上限，绝不无限重试
ALERT_RETRY_BACKOFF_SECONDS=5
DASHBOARD_URL=                    # 通知里的看板入口链接，留空则不附

# 联合风险事件阈值（改动会改变 combined 规则版本，历史评估不受影响）
COMBINED_SEMI_WEIGHT_MAX=0.30     # 半导体占已投资仓位
COMBINED_LEVERAGE_MAX=1.50
COMBINED_DRAWDOWN_MAX=0.10
COMBINED_CASH_BUFFER_MIN=0.30     # 高现金**只作缓冲**，不产生风险事件

# ---------- 事件复盘与阈值回测 v1 ----------
RESEARCH_REFRESH_HOURS=6          # 复盘与规则效果的刷新周期（纯离线分析）

# 风险结果标签阈值。**回测开始前固定，禁止根据结果回头改** ——
# 用结论反推前提得到的 precision 没有任何意义。
LABEL_ACCT_DD_1=0.01
LABEL_ACCT_DD_2=0.02
LABEL_ACCT_DD_3=0.03
LABEL_ACCT_DD_5=0.05
LABEL_POS_MAE_5=0.05
LABEL_POS_MAE_10=0.10
LABEL_POS_MAE_15=0.15
LABEL_POS_DRAG=0.01
LABEL_QQQ_DD=0.05
LABEL_VIX_CRIT=30
LABEL_LIQ_EXCESS=0.15
LABEL_MAINT_BUFFER=1.5
LABEL_LEVERAGE_UP=0.2

# ---------- Flex Query 现金流与真实收益层 v1 ----------
# 在 IBKR 客户端门户创建 Flex Query 后填入。留空则页面显示 not_configured，
# 收益与复盘退回启发式推断，**不影响账户同步、行情同步与风险告警**。
# Token 与 Query ID 都是凭证，绝不提交到 Git。
FLEX_TOKEN=
FLEX_QUERY_ID=
FLEX_SYNC_ENABLED=true
FLEX_SYNC_INTERVAL=12             # 小时。Flex 是 T+1 数据源，无需高频
FLEX_REPORT_LOOKBACK_DAYS=90
FLEX_REQUEST_TIMEOUT=30
FLEX_POLL_INTERVAL=5              # 报表生成中（错误码 1019）时的轮询间隔
FLEX_MAX_POLLS=12                 # 轮询上限，绝不无限等
FLEX_MAX_RETRIES=2                # 重试上限；认证/权限错误立刻停止不重试
FLEX_RECONCILIATION_TOLERANCE=50  # 现金对账容差（基础币种），覆盖结算日差异

# ---------- 集中度规则适用条件（降噪）----------
# Top-N 在少持仓账户上恒等于 ~100%，那是算术必然而非风险信号。
# Top3/Top5 在持仓数量过少时是算术必然。持仓数不足时判 not_applicable，
# 集中风险改由 HHI、等效持仓数与单仓主导度刻画。
RISK_TOP3_MIN_POSITION_COUNT=6
RISK_TOP5_MIN_POSITION_COUNT=10
RISK_HHI_THRESHOLD=0.40            # HHI = Σ权重²，用已投资口径（现金不稀释）
RISK_EFFECTIVE_POSITION_COUNT_MIN=3  # 1/HHI，等效等权持仓数
RISK_HHI_MIN_POSITIONS=2
RISK_EFFECTIVE_MIN_POSITIONS=2
RISK_DOMINANCE_GAP_MIN=0.20        # 最大与第二大持仓的权重差

# ---------- AI 每日风险简报 ----------
# 不配 AI_API_KEY 时简报走**确定性模板**，内容与数字完全一致，只是行文平实。
# AI 服务不可用绝不能导致当天没有简报 —— 模板路径是一等公民，不是残次品。
AI_API_KEY=                          # 留空 = 不使用 AI
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5
AI_MAX_TOKENS=16000
AI_TIMEOUT_SECONDS=120
BRIEF_ENABLED=true
BRIEF_HOUR_LOCAL=6                   # 北京时间，美股收盘且同步完成之后
BRIEF_MINUTE_LOCAL=30

# ---------- 隔夜行情 ----------
# 美股隔夜成交在独立场内（IBKR 的 OVERNIGHT/IBEOS）。实测 SMART 在
# 00:00–04:00 ET 只回收盘价，需要定向到隔夜场才拿得到真实报价。
# 补救只在隔夜时段执行，且只针对回退到 CLOSE 的标的；失败维持收盘价。
IB_OVERNIGHT_QUOTES=true
IB_OVERNIGHT_EXCHANGE=OVERNIGHT


# ---- 机会发现与组合构建 ----
# 分阶段启用：先打开候选扫描，验收后再打开组合提案。
OPPORTUNITY_ENABLED=false
PORTFOLIO_BUILDER_ENABLED=false
# 成功且自选池非空的不同交易日达到此数量后，才允许生成/采纳组合建议。
OPPORTUNITY_SHADOW_MIN_DAYS=5
OPPORTUNITY_MAX_ACTIVE_SYMBOLS=100
OPPORTUNITY_MANUAL_SCAN_COOLDOWN_SECONDS=600
OPPORTUNITY_MIN_PRICE=5
OPPORTUNITY_MIN_MEDIAN_DOLLAR_VOLUME=20000000
OPPORTUNITY_MIN_BARS=120
OPPORTUNITY_FULL_BARS=252
OPPORTUNITY_READY_SCORE=75
OPPORTUNITY_WATCH_SCORE=60
OPPORTUNITY_RISK_PER_TRADE=0.0075
OPPORTUNITY_TARGET_POSITION_MAX=0.20
OPPORTUNITY_SECTOR_MAX=0.35
OPPORTUNITY_MAX_POSITIONS=8
# Hyperliquid XYZ 链上情报：默认关闭；阶段 1–4 仅采集/影子，阶段 5 才人工开启影响
HYPERLIQUID_ENABLED=false
HL_DEX=xyz
HL_DB_PATH=./data/hyperliquid.db
HL_COLLECTOR_ENABLED=false
HL_WALLET_SCORING_ENABLED=false
HL_SIGNAL_SHADOW_ENABLED=false
HL_INTRADAY_ALERTS_ENABLED=false
HL_ALERT_MAX_PER_HOUR=2
HL_ALERT_MAX_PER_DAY=8
HL_SWING_INFLUENCE_ENABLED=false
HL_MAX_CANDIDATE_WALLETS=200
HL_MAX_TRACKED_WALLETS=50
HL_API_WEIGHT_PER_MINUTE=600
HL_BACKFILL_WEIGHT_PCT=0.20
HL_HISTORY_BACKFILL_ENABLED=false
HL_HISTORY_BACKFILL_DAYS=180
# 正股5m快速回溯：单并发、每30秒一个7日请求；不得低于15秒。
HL_EQUITY_BACKFILL_INTERVAL_SECONDS=30
HL_EQUITY_BACKFILL_CHUNK_DAYS=7
# 使用现有Futu OpenD历史K线额度先补stocks候选；仍保留IBKR独立来源做对账。
HL_FUTU_HISTORY_BACKFILL_ENABLED=false
HL_RECENT_TRADES_RETENTION_HOURS=72
HL_RETENTION_DAYS=400
HL_SYMBOL_DENYLIST=SOXL,KORU
HL_MAP_MAX_DEV_RATIO=0.05
HL_MIN_DAILY_NOTIONAL=250000
HL_MIN_OI_NOTIONAL=100000
HL_MAX_MARK_ORACLE_DEVIATION=0.01
HL_MAX_SPREAD_RATIO=0.005
HL_MIN_DIRECTIONAL_WALLETS=5
HL_WALLET_WEIGHT_CAP=0.20
HL_HTTP_TIMEOUT=20

# ---- 可选的 X Monitor 只读数据源 ----
# Docker Compose 挂载宿主机目录；默认使用仓库内被忽略的 data/x-monitor。
X_MONITOR_DATA_PATH=./data/x-monitor
